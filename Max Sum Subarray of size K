class Solution {
    public int maxSubarraySum(int[] arr, int k) {

        int low = 0;
        int n = arr.length;
        int high = k - 1;

        int sum = 0;

        // First window
        for (int i = low; i <= high; i++) {
            sum += arr[i];
        }

        int res = sum;

        // Slide the window
        while (high < n - 1) {

            sum = sum - arr[low];
            low++;

            high++;
            sum = sum + arr[high];

            res = Math.max(res, sum);
        }

        return res;
    }
}
